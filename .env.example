# Copy this file to backend/.env. Do not commit the copy.
DB_URL=jdbc:mysql://localhost:3306/taller_mecanico_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=taller_app
DB_PASSWORD=replace_with_the_local_password
JWT_SECRET=generate_a_unique_base64_secret_of_at_least_32_bytes
INITIAL_ADMIN_NAME=Superadministrador
INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_initial_password
JWT_EXPIRATION_MINUTES=60
COOKIE_SECURE=false
DEVELOPMENT_MODE=true
FRONTEND_ORIGIN=http://localhost:5173
